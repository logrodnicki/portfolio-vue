{
  "name": "portfolio-website-vue",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "test": "npm run lint:check & npm run format:check"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --cache --fix",
      "prettier --check ."
    ]
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/stylelint-module": "^5.2.1",
    "lint-staged": "^16.4.0",
    "nuxt": "^4.4.6",
    "sass-loader": "^10.5.2",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@nuxtjs/style-resources": "^1.2.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^0.55.0",
    "eslint-config-xo-typescript": "^11.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.4",
    "sass": "^1.100.0",
    "stylelint": "^17.13.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.2"
  }
}
